{
  "manifest_version": 3,
  "name": "DeluluTab",
  "short_name": "DeluluTab",
  "description": "A new tab for Chrome and Brave: search, AI, chords, weather, notes and a dashboard you can make your own.",
  "version": "1.2.1",
  "minimum_chrome_version": "111",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": [
    "https://techcrunch.com/*",
    "https://www.theverge.com/*",
    "https://feeds.arstechnica.com/*",
    "https://www.theguardian.com/*",
    "https://www.technologyreview.com/*",
    "https://feeds.bbci.co.uk/*",
    "https://www.bbc.co.uk/*",
    "https://www.bbc.com/*",
    "https://hnrss.org/*",
    "https://www.nasa.gov/*",
    "https://www.cnbc.com/*",
    "https://zenquotes.io/*",
    "https://quotable.vercel.app/*"
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "notifications",
    "identity"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox; script-src 'unsafe-inline'; style-src 'unsafe-inline'; frame-src https: data: blob:; object-src 'none'"
  },
  "sandbox": {
    "pages": ["widget-sandbox.html"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
