{
  "name": "delulutab",
  "private": true,
  "version": "1.1.0",
  "description": "DeluluTab — an AI-focused Chrome New Tab replacement.",
  "author": "GautamVhavle <gautam.vhavle@grigtechnologies.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GautamVhavle/DeluluTab.git"
  },
  "bugs": {
    "url": "https://github.com/GautamVhavle/DeluluTab/issues"
  },
  "homepage": "https://github.com/GautamVhavle/DeluluTab#readme",
  "keywords": [
    "chrome-extension",
    "new-tab",
    "manifest-v3",
    "react",
    "typescript",
    "zustand",
    "keyboard-chords",
    "productivity"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "preview": "vite preview",
    "package": "npm run build && node scripts/package.mjs",
    "verify:dist": "node scripts/package.mjs --check-only",
    "store:assets": "node scripts/store-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.4.0",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.3.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "fflate": "^0.8.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
